PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://review_user:review_pass@localhost:5432/review_db

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters-long

CORS_ORIGIN=http://localhost:3000

PAGE_SIZE=6

RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=ReviHub <onboarding@resend.dev>

# Request analytics (admin pages). 32 random bytes as hex, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it analytics is off. Changing it makes old IPs unreadable
ANALYTICS_KEY=
