{
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2023",
    "types": ["vite/client"],
    "lib": ["dom", "dom.iterable", "ES2023"],
    "skipLibCheck": true,
    "strict": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
