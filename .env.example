# Copy to .env. Read by docker-compose.yml and docker-compose.prod.yml.
# The defaults work for local development; change them in production.

POSTGRES_USER=review_user
POSTGRES_PASSWORD=review_pass
POSTGRES_DB=review_db

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters-long

# Allowed origins, comma-separated
CORS_ORIGIN=http://localhost:3000
# Reviews per page (the catalog always shows 12 titles per page)
PAGE_SIZE=6

# Used to send email verification codes, see https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=ReviHub <onboarding@resend.dev>

# Request analytics (admin pages). 32 random bytes as hex, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it analytics is off. Changing it makes old IPs unreadable
ANALYTICS_KEY=

# Secret part of the demo link for recruiters: https://<site>/demo?key=<key>.
# Every visit creates a new demo account, deleted after 7 days.
# Without it the link is off. Changing it disables links already sent.
# At least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEMO_LOGIN_KEY=
